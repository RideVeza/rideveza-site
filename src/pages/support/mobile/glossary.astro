---
import HelpLayout from "../../../layouts/HelpLayout.astro";

// Icon tiles are shared with the guardian glossary exports (pre-styled PNGs).
const entries = [
  {
    icon: "icon-driver.png",
    title: "Driver",
    desc: "Marks the driver on a run, in the run's team section.",
  },
  {
    icon: "icon-attendant.png",
    title: "Attendant",
    desc: "Marks an attendant on a run's team, and shows that an attendant is present on the run.",
  },
  {
    icon: "icon-lpn.png",
    title: "LPN",
    desc: "Marks an LPN (licensed practical nurse) on a run's team, and shows that an LPN is present on the run.",
  },
  {
    icon: "icon-supervisor.svg",
    title: "Supervisor",
    desc: "Marks a supervisor on a run — the staff member in charge of the run.",
  },
  {
    icon: "icon-care.png",
    title: "Care",
    desc: "Shown when a rider has care instructions (a care plan). Review these before the run.",
  },
  {
    icon: "icon-equipment.png",
    title: "Equipment",
    desc: "Shown when a rider uses equipment on the bus.",
  },
  {
    icon: "icon-medical.png",
    title: "Medical",
    desc: "Shown when a rider has a medical condition.",
  },
  {
    icon: "icon-met-at-bus.png",
    title: "Met at the bus",
    desc: "Shown when a rider must be met at the bus by a guardian at their stop.",
  },
  {
    icon: "icon-custody.png",
    title: "Custody",
    desc: "Shown when a rider has a custody consideration.",
  },
  {
    icon: "icon-support-staff.png",
    title: "Support staff",
    desc: "Shown when a rider requires an attendant or an LPN (or both) on the bus.",
    wide: true,
  },
];
---

<HelpLayout
  title="Icon glossary"
  description="What each icon in the Veza Mobile App means."
  back="/support/mobile/"
  pdf
>
  <h1>Icon glossary</h1>

  <p class="overview">
    Veza uses a variety of icons to help you navigate the app. Here is a guide
    to their meanings.
  </p>

  <ul class="glossary">
    {entries.map((e) => (
      <li class="entry">
        <span class="entry__icon">
          <img
            src={`/images/support/guardian/icons/${e.icon}`}
            alt=""
            width={e.wide ? 109 : 60}
            height="60"
            loading="lazy"
          />
        </span>
        <div class="entry__text">
          <h2 class="entry__title">{e.title}</h2>
          <p class="entry__desc">{e.desc}</p>
        </div>
      </li>
    ))}
  </ul>
</HelpLayout>

<style>
  /* Same reference-list card as the guardian glossary. */
  .glossary {
    list-style: none;
    margin: 0;
    padding: 0 22px;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-soft);
  }

  .entry {
    display: flex;
    align-items: center;
    gap: 32px;
    padding: 22px 0;
    border-bottom: 1px solid var(--border);
  }

  .entry:last-child {
    border-bottom: none;
  }

  .entry__icon {
    flex: none;
    width: 120px;
    display: flex;
    align-items: center;
  }

  .entry__icon img {
    display: block;
    height: 60px;
    width: auto;
  }

  .entry__text {
    flex: 1 1 auto;
    min-width: 0;
  }

  .entry__title {
    font-family: var(--font-display);
    font-size: 1.12rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--navy);
    margin: 0 0 4px;
  }

  .entry__desc {
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
  }

  @media (max-width: 480px) {
    .glossary {
      padding: 0 16px;
    }
    .entry {
      gap: 16px;
      padding: 20px 0;
    }
    .entry__icon {
      width: 112px;
    }
  }

  /* A glossary is only worth printing if the whole table is on one sheet —
     flipping back and forth to look up an icon defeats the point. At screen
     size these ten rows run to 1046pt against 707pt of printable page.

     The icon is not what costs the height: at 60px it stands 45pt tall while
     the text beside it is 44pt on one line and 60pt on two, so shrinking the
     image alone saves 6pt of the 339pt needed. The row padding is the real
     expense — 22px top and bottom on every row is 330pt of white space by
     itself. So the padding comes down first, the icon and type follow, and
     the table lands at 671pt. That leaves ~36pt spare, which is less than one
     row: adding an entry here will need these numbers revisited.

     The guardian glossary carries the same block, tuned to the same numbers —
     change one and check the other. */
  @media print {
    .entry {
      padding: 8px 0;
      gap: 18px;
    }

    .entry__icon {
      width: 92px;
    }

    .entry__icon img {
      height: 24px;
    }

    .entry__title {
      font-size: 0.9rem;
      margin-bottom: 2px;
    }

    .entry__desc {
      font-size: 0.82rem;
    }
  }
</style>
